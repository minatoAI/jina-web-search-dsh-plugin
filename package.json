{
  "name": "dsh-jina",
  "version": "0.10.0",
  "description": "Jina AI tools for DeepSeek Harness: search (incl. arxiv/ssrn academic domains), read (plain, ReaderLM-v2, and a dedicated jina_read_pdf for jina-ocr-v1 document OCR), screenshot, embed, rerank, classify, pdf, expand, datetime, primer — with a Plugins-page UI for several API keys (round-robin + automatic failover), a manually configurable local proxy, and reader options.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./ui/client.js",
    "./ui": "./ui/index.js",
    "./ui/package.json": "./ui/package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "ui/index.js",
    "ui/package.json",
    "ui/client.js",
    "README.md",
    "README.en.md",
    "change-log.md",
    "change-log.en.md",
    "LICENSE",
    "primer.js",
    "proxy.js",
    "keys.js",
    "tool-contracts.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "jina",
    "jina-ai",
    "search",
    "embedding",
    "rerank",
    "plugin"
  ],
  "scripts": {
    "test": "node --test"
  }
}
